# ============================================================
# Виртуальное окружение Python
# ============================================================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ============================================================
# Кэш эмбеддингов (пересчитывается автоматически)
# ============================================================
.cache/

# ============================================================
# Рабочие черновики карточек (не идут в RAG, живут до ревью)
# ============================================================
_meta/_drafts/

# ============================================================
# Сырьё: выгрузки конфигурации 1С, PDF, временные файлы
# НЕ КОММИТИТЬ. Всё, что попадает в _raw/, остаётся локально.
# ============================================================
_raw/
_raw/unf30_xml/

# ============================================================
# Сетка безопасности для файлов 1С
# Если случайно положите .epf или .cf не в _raw/, Git их тоже
# не закоммитит. Это защита от «ой, залил 2 ГБ в репозиторий».
# ============================================================

# Внешние обработки и отчёты
*.epf
*.erf

# Файлы конфигурации (основная и расширения)
*.cf
*.cfe
*.cfu

# Выгрузки информационной базы (полная резервная копия)
*.dt

# Служебные файлы 1С
*.mdo
*.bsl~
*.cfl

# ============================================================
# Архивы и крупные бинарники (общая защита)
# ============================================================
*.zip
*.7z
*.rar
*.tar
*.gz

# ============================================================
# Что НЕ игнорируется и ДОЛЖНО попасть в репозиторий:
# ------------------------------------------------------------
# _meta/config_metadata.json — компактный индекс конфигурации
#   (собирается из XML, весит <1 МБ, нужен для валидации
#    карточек на любой машине без 2 ГБ выгрузки).
#
# tools/config_export/*.txt — код обработки 1С (текст, не .epf).
#
# tools/parse_config_xml.py, tools/validate_cards.py — парсер и
#   валидатор (Python-код).
#
# kb/unf30/**/*.md — все карточки базы знаний.
# ============================================================
